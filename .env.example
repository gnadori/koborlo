# Kóborló környezeti változók

# Google Maps API kulcs (csak a Street View megjelenítéséhez szükséges!)
# Igényelhető: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=

# Firebase konfiguráció (opcionális felhőalapú közös toplistához)
# Ha üresen hagyod, az app automatikusan a böngésző LocalStorage-ét használja!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
